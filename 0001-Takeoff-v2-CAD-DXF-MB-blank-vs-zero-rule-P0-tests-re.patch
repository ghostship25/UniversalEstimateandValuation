--- /dev/null
+++ b/tests/ipcMath.test.ts
@@ -0,0 +1,35 @@
+import { describe, it, expect } from 'vitest';
+import { computeIpc } from '../src/services/ipcMath';
+
+const base = { grossThisBill: 100000, grossBeforeThisBill: 0, retentionPercent: 5, advanceGiven: 0, advanceRecoveryPercent: 0, advanceRecoveredBefore: 0, taxPercent: 10 };
+
+describe('IPC maths', () => {
+  it('retention, tax and net on a simple bill', () => {
+    const r = computeIpc(base);
+    expect(r).toMatchObject({ gross: 100000, retention: 5000, advance: 0, afterDeductions: 95000, tax: 9500, net: 104500, grossCumulative: 100000 });
+  });
+  it('uses the contract percentages, nothing is assumed', () => {
+    const r = computeIpc({ ...base, retentionPercent: 0, taxPercent: 0 });
+    expect(r).toMatchObject({ retention: 0, tax: 0, net: 100000 });
+  });
+  it('advance is recovered as a % of each bill', () => {
+    const r = computeIpc({ ...base, advanceGiven: 50000, advanceRecoveryPercent: 20 });
+    expect(r.advance).toBe(20000); expect(r.advanceOutstanding).toBe(30000);
+  });
+  it('advance recovery is capped at what is still outstanding and tracked across bills', () => {
+    const r = computeIpc({ ...base, advanceGiven: 50000, advanceRecoveryPercent: 20, advanceRecoveredBefore: 40000 });
+    expect(r.advance).toBe(10000); expect(r.advanceOutstanding).toBe(0);
+    expect(computeIpc({ ...base, advanceGiven: 50000, advanceRecoveryPercent: 20, advanceRecoveredBefore: 50000 }).advance).toBe(0);
+  });
+  it('no recovery percentage means no recovery', () => expect(computeIpc({ ...base, advanceGiven: 50000 }).advance).toBe(0));
+  it('cumulative gross adds the earlier bills', () => expect(computeIpc({ ...base, grossBeforeThisBill: 250000 }).grossCumulative).toBe(350000));
+  it('rounds to 2 decimals at each step so the certificate adds up', () => {
+    const r = computeIpc({ ...base, grossThisBill: 33333.333, retentionPercent: 5, taxPercent: 7.5 });
+    expect(r.net).toBeCloseTo(r.afterDeductions + r.tax, 2);
+    expect(Number.isInteger(Math.round(r.net * 100))).toBe(true);
+  });
+  it('garbage inputs never produce NaN', () => {
+    const r = computeIpc({ ...base, retentionPercent: NaN, taxPercent: -5, grossThisBill: NaN });
+    expect(Number.isFinite(r.net)).toBe(true);
+  });
+});
diff --git a/tests/mbQuantity.test.ts b/tests/mbQuantity.test.ts
new file mode 100644
index 0000000..e33be70
--- /dev/null
+++ b/tests/mbQuantity.test.ts
@@ -0,0 +1,38 @@
+import { describe, it, expect } from 'vitest';
+import { computeRowBaseQuantity } from '../src/services/mbDependencyEngine';
+import { evalCellValue, parseNumericText, isBlankCell } from '../src/services/mbCellValue';
+
+const all = { no: true, l: true, b: true, h: true };
+const q = (no: number | null, l: number | null, b: number | null, h: number | null, use = all) => computeRowBaseQuantity({ no, l, b, h }, use);
+
+describe('MB row quantity: a typed 0 multiplies, an empty or text cell is skipped', () => {
+  it('multiplies all numbers', () => expect(q(2, 5, 3, 4)).toBe(120));
+  it('N=1 L=3 B=6 H=0 gives 0', () => expect(q(1, 3, 6, 0)).toBe(0));
+  it('N=1 L=3 B=6 H empty gives 18', () => expect(q(1, 3, 6, null)).toBe(18));
+  it('a zero in any column gives 0', () => {
+    expect(q(0, 5, 2, 3)).toBe(0);
+    expect(q(2, 0, 3, 4)).toBe(0);
+    expect(q(2, 5, 0, 4)).toBe(0);
+  });
+  it('blank columns are skipped wherever they are', () => {
+    expect(q(null, 5, 2, 3)).toBe(30);
+    expect(q(2, null, 3, 4)).toBe(24);
+    expect(q(2, 5, null, null)).toBe(10);
+  });
+  it('all blank gives 0, not 1', () => expect(q(null, null, null, null)).toBe(0));
+  it('keeps negative values (deductions)', () => expect(q(-1, 2, 3, null)).toBe(-6));
+  it('only included columns take part', () => {
+    expect(q(2, 5, 3, 4, { no: true, l: true, b: false, h: false })).toBe(10);
+    expect(q(2, 0, 3, 4, { no: true, l: false, b: true, h: true })).toBe(24); // the excluded 0 is ignored
+  });
+});
+
+describe('reading a cell', () => {
+  const ev = (f: string) => (f === '=L1*2' ? 10 : NaN);
+  it('numbers, including 0', () => { expect(evalCellValue(0, ev)).toBe(0); expect(evalCellValue(3.5, ev)).toBe(3.5); expect(evalCellValue('12', ev)).toBe(12); });
+  it('empty / undefined / null are blank', () => { expect(evalCellValue('', ev)).toBeNull(); expect(evalCellValue('  ', ev)).toBeNull(); expect(evalCellValue(undefined, ev)).toBeNull(); expect(evalCellValue(null, ev)).toBeNull(); });
+  it('text is blank', () => { expect(evalCellValue('NA', ev)).toBeNull(); expect(evalCellValue('m', ev)).toBeNull(); });
+  it('formulas use their result; an unresolvable formula is blank', () => { expect(evalCellValue('=L1*2', ev)).toBe(10); expect(evalCellValue('=bad', ev)).toBeNull(); });
+  it('numbers with thousands separators', () => expect(parseNumericText('1,250.5')).toBe(1250.5));
+  it('isBlankCell', () => { expect(isBlankCell('')).toBe(true); expect(isBlankCell('NA')).toBe(true); expect(isBlankCell(0)).toBe(false); expect(isBlankCell('=L1')).toBe(false); });
+});
diff --git a/tests/refRemap.test.ts b/tests/refRemap.test.ts
new file mode 100644
index 0000000..90d2d8c
--- /dev/null
+++ b/tests/refRemap.test.ts
@@ -0,0 +1,70 @@
+import { describe, it, expect } from 'vitest';
+import { remapFormula, remapEstimateItems, remapValuationRows, remapValuationItemOrder } from '../src/services/refRemap';
+
+const row = (id: string, extra: any = {}) => ({ id, particulars: id, no_of_units: 1, length: 1, breadth: 1, height: 1, quantity: 0, ...extra });
+const item = (id: string, rows: any[]) => ({ id, mb_rows: rows } as any);
+
+describe('remapFormula', () => {
+  // old layout: items A,B,C ; B moves to the front, C is deleted
+  const maps = {
+    mapItem: (o: number) => ({ 0: 1, 1: 0, 2: null } as any)[o],
+    mapRow: (o: number, r: number) => (o === 0 ? ({ 0: 1, 1: 2 } as any)[r] ?? null : r),
+  };
+  it('cross-item references follow the item', () => expect(remapFormula('=I2.R1.L*2', 0, maps).text).toBe('=I1.R1.L*2'));
+  it('item-level references follow the item', () => expect(remapFormula('=I1.QTY/10', 1, maps).text).toBe('=I2.QTY/10'));
+  it('same-item references follow row insertions', () => expect(remapFormula('=L1+B2', 0, maps).text).toBe('=L2+B3'));
+  it('ranges and R-forms follow rows', () => {
+    expect(remapFormula('=SUM(L1:L2)', 0, maps).text).toBe('=SUM(L2:L3)');
+    expect(remapFormula('=R1.Thickness*2', 0, maps).text).toBe('=R2.Thickness*2');
+  });
+  it('a reference to a deleted item becomes #REF!', () => { const r = remapFormula('=I3.R1.L+5', 0, maps); expect(r.text).toBe('=#REF!+5'); expect(r.broken).toBe(1); });
+  it('a reference to a deleted row becomes #REF!', () => { const r = remapFormula('=L3', 0, { ...maps, mapRow: () => null }); expect(r.text).toBe('=#REF!'); expect(r.broken).toBe(1); });
+  it('leaves code based references, quoted text and plain numbers alone', () => {
+    expect(remapFormula('=ITEM("1.1").R2.L*2', 0, maps).text).toBe('=ITEM("1.1").R2.L*2');
+    expect(remapFormula('=2*3.5', 0, maps).text).toBe('=2*3.5');
+    expect(remapFormula('12.5', 0, maps).text).toBe('12.5');
+  });
+});
+
+describe('remapEstimateItems', () => {
+  const a = item('A', [row('a1', { length: 10 }), row('a2', { length: '=L1*2' })]);
+  const b = item('B', [row('b1', { length: '=I1.R2.L' }), row('b2', { length: '=R1.L+I1.QTY' })]);
+  it('no structural change: untouched', () => { const r = remapEstimateItems([a, b], [a, b]); expect(r.items).toBe(r.items); expect(r.broken).toBe(0); });
+  it('adding an item or row at the end changes nothing', () => {
+    const r = remapEstimateItems([a, b], [a, b, item('C', [row('c1')])]); expect(r.items[1].mb_rows![0].length).toBe('=I1.R2.L');
+  });
+  it('moving items keeps references on the same cells', () => {
+    const r = remapEstimateItems([a, b], [b, a]); // B first
+    expect(r.items[0].mb_rows![0].length).toBe('=I2.R2.L');  // B row1 still points at A.row2 (A is now item 2)
+    expect(r.items[0].mb_rows![1].length).toBe('=L1+I2.QTY'.replace('L1', 'R1.L').replace('R1.L+', 'R1.L+')); // same-item R1 stays R1
+    expect(r.items[1].mb_rows![1].length).toBe('=L1*2');
+  });
+  it('inserting a row above shifts the references to it', () => {
+    const a2 = item('A', [row('new'), ...a.mb_rows]);
+    const r = remapEstimateItems([a, b], [a2, b]);
+    expect(r.items[0].mb_rows![2].length).toBe('=L2*2');        // was =L1*2 (a1 is now row 2)
+    expect(r.items[1].mb_rows![0].length).toBe('=I1.R3.L');     // was =I1.R2.L (a2 is now row 3)
+  });
+  it('deleting a referenced row gives #REF! and counts it', () => {
+    const a3 = item('A', [a.mb_rows![0]]);
+    const r = remapEstimateItems([a, b], [a3, b]);
+    expect(r.items[1].mb_rows![0].length).toBe('=#REF!'); expect(r.broken).toBeGreaterThan(0);
+  });
+  it('deleting an item gives #REF! for references to it', () => {
+    const r = remapEstimateItems([a, b], [b]);
+    expect(r.items[0].mb_rows![0].length).toBe('=#REF!');
+  });
+});
+
+describe('valuation rows', () => {
+  const vr = (id: string, item: string, extra: any = {}) => ({ id, mb_id: 'mb1', boq_item_id: item, particulars: id, no_of_units: 1, length: 1, breadth: 1, height: 1, quantity_this_bill: 0, ...extra } as any);
+  it('row insertion inside a (book,item) group shifts same-item references', () => {
+    const prev = [vr('r1', 'A', { length: 4 }), vr('r2', 'A', { length: '=L1*2' })];
+    const next = [vr('new', 'A'), prev[0], prev[1]];
+    expect(remapValuationRows(prev, next, ['A']).rows[2].length).toBe('=L2*2');
+  });
+  it('item order change moves item references', () => {
+    const rows = [vr('r1', 'A', { length: '=I2.R1.L' }), vr('r2', 'B', { length: 3 })];
+    expect(remapValuationItemOrder(rows, ['A', 'B'], ['B', 'A']).rows[0].length).toBe('=I1.R1.L');
+  });
+});
diff --git a/tests/takeoffGeometry.test.ts b/tests/takeoffGeometry.test.ts
